# Copy to .env (or set in your environment / container platform)
PORT=3000
HOST=0.0.0.0
# Milliseconds between simulated deliveries for live matches (0 disables the live engine)
LIVE_TICK_MS=4000
# When a live match ends, bring the next fixture forward so there is always live action
AUTO_ADVANCE_FIXTURES=true
# Persist the in-memory store to a JSON snapshot (omit for pure in-memory)
DATA_FILE=
# Seed for the deterministic demo dataset
SEED=2026
# Comma-separated list of allowed CORS origins, or *
CORS_ORIGINS=*
# Optional API keys (x-api-key header) – keyed clients get 10x the rate limit
API_KEYS=
RATE_LIMIT_PER_MIN=600
# Optional bearer token required on /mcp
MCP_TOKEN=
